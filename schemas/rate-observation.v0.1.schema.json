{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JP Cost — Atomic price or resource observation v0.1",
  "description": "One parsed observation per JSONL line. Never combine or deduplicate rates across source editions without review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "record_id",
    "source_id",
    "page_no",
    "raw_description",
    "observation_type",
    "extraction_status",
    "review_status"
  ],
  "properties": {
    "record_type": {
      "const": "rate_observation"
    },
    "record_id": {
      "type": "string",
      "minLength": 6
    },
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[A-Z]+-[0-9]{3}$"
    },
    "source_document_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "page_no": {
      "type": "integer",
      "minimum": 1
    },
    "table_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "row_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source_cell": {
      "type": [
        "string",
        "null"
      ]
    },
    "bbox_pt": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "raw_description": {
      "type": "string"
    },
    "normalized_description": {
      "type": [
        "string",
        "null"
      ]
    },
    "observation_type": {
      "enum": [
        "material_price",
        "labour_rate",
        "equipment_rate",
        "transport_rate",
        "finished_work_rate",
        "resource_coefficient",
        "product_price",
        "other"
      ]
    },
    "resource_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "unit_normalized": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_numeric_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "numeric_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_fy": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope_inclusions": {
      "type": [
        "string",
        "null"
      ]
    },
    "tax_included": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "transport_included": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "contract_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_item_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_recipe_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_text_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "extraction_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "extraction_status": {
      "enum": [
        "EXTRACTED_UNCHECKED",
        "PAGE_CHECKED",
        "SOURCE_VERIFIED",
        "BLOCKED"
      ]
    },
    "review_status": {
      "enum": [
        "UNREVIEWED",
        "REVIEW_REQUIRED",
        "APPROVED_FOR_PRIVATE_DERIVATION",
        "APPROVED_FOR_PUBLIC_PROJECTION"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
